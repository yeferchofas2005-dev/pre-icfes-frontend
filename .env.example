# Plantilla de Variables de Entorno para Preicfes Gratuito
# Copia este archivo a .env y completa los valores correspondientes.

NG_APP_GOOGLE_API_KEY=tu_google_api_key
NG_APP_GOOGLE_SPREADSHEET_ID=tu_spreadsheet_id
